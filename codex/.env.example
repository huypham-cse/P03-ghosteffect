# Template only. Copy to PROJECT_ROOT/.env during implementation.
# Load before importing HF/Transformers. Resolve relative paths against PROJECT_ROOT.
# No credentials are supplied here. Never export the real .env in run artifacts.
PROJECT_ROOT=.
HF_TOKEN=
HF_HOME=runtime/cache/huggingface
HF_HUB_CACHE=runtime/cache/huggingface/hub
HF_XET_CACHE=runtime/cache/huggingface/xet
TORCH_HOME=runtime/cache/torch
MODEL_ROOT=runtime/models
INFERENCE_PROFILE=hf-main-h100-v6
INFERENCE_DTYPE=bfloat16
INFERENCE_ENGINE_VERSION=0.11.0
QWEN_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
QWEN_MODEL_REVISION=cc594898137f460bfe9f0759e9844b3ce807cfb5
UITARS_MODEL_ID=ByteDance-Seed/UI-TARS-1.5-7B
UITARS_MODEL_REVISION=683d002dd99d8f95104d31e70391a39348857f4e
GUIOWL_MODEL_ID=mPLUG/GUI-Owl-7B
GUIOWL_MODEL_REVISION=7c1644c0288da07435a485701d0fea0ac353f38a
QWEN_BASE_URL=http://127.0.0.1:8101/v1
UITARS_BASE_URL=http://127.0.0.1:8102/v1
GUIOWL_BASE_URL=http://127.0.0.1:8103/v1
SELFHOST_API_KEY=
AGENTPROG_WORKFLOW_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
AGENTPROG_EXECUTOR_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
AGENTPROG_LOCATOR_MODEL=ByteDance-Seed/UI-TARS-1.5-7B
VERIFIER_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
ALLOW_PAID_API=false
# Optional upstream-reference only; not downloadable weights.
GEMINI_MODEL_ID=gemini-2.5-pro
GEMINI_API_KEY=
GEMINI_BASE_URL=
ARK_API_KEY=
DOUBAO_BASE_URL=

# h100-plan-v6 starting limits; benchmark before final freeze.
GPU_COUNT=1
TENSOR_PARALLEL_SIZE=1
MAX_RESIDENT_MODEL_SERVICES=2
GPU_MEMORY_UTILIZATION_PER_SERVICE=0.45
MAX_MODEL_LEN=32768
MAX_NUM_SEQS=2
MAX_INFLIGHT_REQUESTS=2
MAX_AVD_WORKERS=4
INITIAL_AVD_WORKERS=1
MAX_IMAGES_PER_REQUEST=5
# This optional recipe flag does not disable required calibration coverage/readiness.
RUN_CERT1_EXTRA_COLLECTION=false
UPSTREAM_REFERENCE_ENABLED=false

# Stage-gated experiment scope. These flags are consumed by future tooling.
IMAGE_POLICY=upstream_recipe
HISTORY_POLICY=upstream_recipe
RUN_PROTECTED_BENCHMARK=false
RUN_LIVE_VETTED_SENTINELS=false
# Milestone A/B + native only; not full paper completion.
PLANNED_DEFAULT_ATTEMPTS=878
MAX_INSTRUMENTATION_RETRIES=88
MAX_RETRIES_PER_CASE=1

# Target is the draft's device study. False stage flags mean not ready yet.
# Future runner must assert these fields; no runner is implemented by this template.
STUDY_TARGET=paper_draft
TASK_REGISTRY=P01-P40
REQUIRE_H4_EVALUATION=true
ALLOW_SCOPE_DOWNGRADE=false
PLANNED_WITH_PROTECTED_ATTEMPTS=1090

EVALUATION_FOLLOWUP_SECONDS=300

# Stage-selected topology; future runner resolves these defaults and records actual values.
# One engine per checkpoint, not per role. AgentProg workflow/executor/V1 share Qwen.
# Qwen-only stages may use .85; dual Qwen+locator/agent starts at .45+.45.
# MAX_AVD_WORKERS=4 is the core cap; no 8-worker sweep in this revision.
